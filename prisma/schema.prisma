datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  category         String   // timber, plywood-mdf, doors, wpc, windows, modular-interiors
  subcategory      String?  // hardwood, softwood, commercial, waterproof, etc.
  shortDescription String
  description      String
  featured         Boolean  @default(false)
  published        Boolean  @default(true)
  images           String   // JSON array of image URLs
  variants         String?  // JSON array of variants/sizes
  specifications   String?  // JSON key-value map or array of specs
  applications     String?  // JSON array of typical applications
  finishOptions    String?  // JSON array or text
  associatedBrand  String?  // Brand name if applicable
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Project {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  category       String   // residential, commercial, kitchens, wardrobes, doors, windows, office
  location       String?
  overview       String
  description    String
  coverImage     String
  galleryImages  String   // JSON array of URLs
  materialsUsed  String?  // JSON array of materials
  featured       Boolean  @default(false)
  published      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Brand {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    String   // Category it belongs to
  description String?
  logoUrl     String
  websiteUrl  String?
  featured    Boolean  @default(true)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Service {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  shortDesc       String
  description     String
  imageUrl        String
  benefits        String?  // JSON array
  processSteps    String?  // JSON array
  relatedProducts String?  // JSON array
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Enquiry {
  id                     String   @id @default(cuid())
  fullName               String
  phone                  String
  email                  String?
  customerType           String   // Homeowner, Architect, Interior Designer, Contractor, Builder, Other
  productCategory        String   // Timber, Plywood & MDF, Doors, WPC, Windows, Modular Interiors, Services, Other
  projectLocation        String?
  estimatedQuantity      String?
  requirementDescription String
  attachmentUrl          String?
  consent                Boolean  @default(true)
  status                 String   @default("New") // New, Contacted, Requirement Identified, Quotation Sent, Negotiation, Converted, Lost
  internalNotes          String?  // JSON array or text of timestamped notes
  source                 String?  @default("Website")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
